# ── URL pública del sitio (para OpenGraph y enlaces /i/{token}) ──
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# ── Supabase (RSVP personalizado) ──
# Créalos en https://supabase.com → proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# ⚠️ SECRETO: solo servidor. Nunca lo expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# ── Panel de administración (/admin?key=...) ──
ADMIN_DASHBOARD_KEY=elige-una-clave-larga-y-privada
